{
  "name": "techcheck-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --preserve-symlinks scripts/next.mjs dev --webpack --hostname 127.0.0.1",
    "build": "node --preserve-symlinks scripts/next.mjs build --webpack",
    "start": "node --preserve-symlinks scripts/next.mjs start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/generate-fixtures.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "openai": "^7.42.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
